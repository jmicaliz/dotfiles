#!/bin/bash
set -uo pipefail
# Prefer a Remote SSH server binary, then a local `code`, then the Flatpak's bundled CLI.
VSCODE_CLI=()
VSCODE_BIN=$(find ~/.vscode-server -maxdepth 1 -name "code-*" -type f 2>/dev/null | head -1)
if [ -z "$VSCODE_BIN" ]; then
    VSCODE_BIN=$(find ~/.vscode-server/bin -maxdepth 3 -name "code-server" -not -path "*/legacy-mode/*" 2>/dev/null | head -1)
fi
if [ -z "$VSCODE_BIN" ] && command -v code &>/dev/null; then
    VSCODE_BIN="code"
fi
if [ -n "$VSCODE_BIN" ]; then
    VSCODE_CLI=("$VSCODE_BIN")
elif command -v flatpak &>/dev/null && flatpak info --user com.visualstudio.code &>/dev/null; then
    VSCODE_CLI=(flatpak run --user --command=code com.visualstudio.code)
fi
if [ ${#VSCODE_CLI[@]} -eq 0 ]; then
    echo "Skipping VS Code extensions: no VS Code CLI found (open VS Code or connect via Remote SSH, then run 'chezmoi apply')."
    exit 0
fi
while IFS= read -r extension; do
    [ -z "$extension" ] && continue
    "${VSCODE_CLI[@]}" --install-extension "$extension" --force 2>&1 | grep -v "DeprecationWarning\|node --trace"
done <<'EXTENSIONS'
{{ template "vscode-extensions.txt" . }}
EXTENSIONS
