#!/usr/bin/env python3
"""Flag workplace-identifying text in files headed for the public dotfiles repo."""

import os
import re
import subprocess
import sys
from pathlib import Path

PATTERNS = {
    "Slack ID": re.compile(r"\b[UCWG]0[A-Z0-9]{8,10}\b"),
    "Databricks workspace host": re.compile(r"adb-\d{6,}\.\d+\.azuredatabricks\.net"),
    "tenant hostname": re.compile(r"\b[a-z0-9-]+\.(?:palantirfoundry\.com|atlassian\.net|sharepoint\.com|myworkday\.com/[a-z0-9]+)\b", re.I),
    "email": re.compile(r"\b[A-Za-z0-9._%+-]+@(?!gmail\.com|users\.noreply\.github\.com|anthropic\.com|example\.com)[A-Za-z0-9.-]+\.[a-z]{2,}\b"),
    "token": re.compile(r"\b(?:lin_api_|sk-bf-|dose|dapi|ghp_|gho_|xox[bpa]-)[A-Za-z0-9_-]{10,}|eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}"),
}

# Rendered from Keeper by chezmoi; holds the literal values that must never be committed.
DENYLIST = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "dotfiles-guard" / "denylist"


def load_denylist() -> list[str]:
    if not DENYLIST.exists():
        return []
    return [line for line in DENYLIST.read_text().splitlines() if len(line) >= 6 and not line.startswith("#")]


def scan(text: str, denylist: list[str]) -> list[tuple[int, str]]:
    hits = []
    for lineno, line in enumerate(text.splitlines(), 1):
        if "dotfiles-guard: allow" in line:
            continue
        for label, pattern in PATTERNS.items():
            if pattern.search(line):
                hits.append((lineno, label))
        lowered = line.lower()
        if any(value.lower() in lowered for value in denylist):
            hits.append((lineno, "Keeper value"))
    return hits


def staged_files() -> dict[str, str]:
    names = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"], capture_output=True, text=True, check=True).stdout.split("\0")
    out = {}
    for name in filter(None, names):
        blob = subprocess.run(["git", "show", f":{name}"], capture_output=True, check=False).stdout
        if b"\0" not in blob:
            out[name] = blob.decode("utf-8", "replace")
    return out


def main() -> int:
    args = sys.argv[1:]
    files = staged_files() if args == ["--staged"] else {p: Path(p).read_text(errors="replace") for p in args if Path(p).is_file()}
    denylist = load_denylist()
    found = False
    for name, text in files.items():
        for lineno, label in scan(text, denylist):
            print(f"{name}:{lineno}: {label}")
            found = True
    if found:
        print("Identifying text found. Move it to Keeper, or add 'dotfiles-guard: allow' to the line if it is intentional.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
