{{- range (index .secrets .machine) }}
{{-   $value := "" }}
{{-   if eq $.secretsBackend "bitwarden" }}
{{-     if hasKey . "field" }}{{ $value = (index (bitwardenFields "item" .item) .field).value }}
{{-     else }}{{ $value = (bitwarden "item" .item).login.password }}{{ end }}
{{-   else if eq $.secretsBackend "keeper" }}
{{-     if hasKey . "field" }}{{ $value = includeTemplate "keeper-field" (list .item .field) }}
{{-     else }}{{ $value = keeperFindPassword .item }}{{ end }}
{{-   end }}
{{-   if hasKey . "suffix" }}{{ $value = print $value .suffix }}{{ end }}
export {{ .env }}={{ $value | replace "'" "'\\''" | squote }}
{{- end }}
